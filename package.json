{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "check": "oxfmt . && oxlint --type-aware --fix --fix-dangerously",
    "clean": "rm -rf packages/*/dist apps/*/dist node_modules packages/*/node_modules apps/*/node_modules packages/*/*.tgz",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --fix --fix-dangerously",
    "lint:check": "oxlint --type-aware",
    "test": "pnpm run test:portless && vitest run",
    "test:node-smoke": "node scripts/node-smoke.ts",
    "test:portless": "node --test scripts/portless-dev.test.ts",
    "test:check-docs": "node scripts/check-docs.test.ts",
    "test:packages": "vitest run",
    "verify": "pnpm pipeline verify",
    "verify:all": "pnpm pipeline verify && pnpm pipeline all-root --include-workspace-root && pnpm run test:node-smoke",
    "check:docs": "node scripts/check-docs.ts",
    "check:deps": "node scripts/check-deps.ts",
    "version": "changeset version && pnpm install",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "portless": "0.15.6",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
