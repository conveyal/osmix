{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "oxfmt --check . && oxlint",
    "clean": "rm -rf packages/*/dist apps/*/dist node_modules packages/*/node_modules apps/*/node_modules packages/*/*.tgz",
    "dev": "portless",
    "fix": "oxfmt . && oxlint --fix",
    "knip": "knip",
    "release": "node scripts/release.ts",
    "smoke": "node scripts/node-smoke.ts",
    "test": "vitest run",
    "verify": "pnpm run check && pnpm run knip && pnpm run test",
    "version": "changeset version && pnpm install"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "0.2.1",
    "@types/node": "catalog:",
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.21.0 <25",
      "onFail": "download"
    }
  }
}
