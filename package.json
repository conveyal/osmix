{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "oxfmt . && oxlint --type-aware --fix --fix-dangerously",
    "clean": "rm -rf packages/*/dist apps/*/dist node_modules packages/*/node_modules apps/*/node_modules packages/*/*.tgz",
    "dev": "portless",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --fix --fix-dangerously",
    "lint:check": "oxlint --type-aware",
    "test": "pnpm run test:design-lint && vitest run",
    "test:all": "pnpm run typecheck && pnpm run check && VITEST_INCLUDE_APPS=1 vitest run",
    "test:apps": "VITEST_INCLUDE_APPS=1 vitest run '--project=@osmix/app' '--project=@osmix/bench*'",
    "test:node-smoke": "node scripts/node-smoke.ts",
    "test:check-docs": "node scripts/check-docs.test.ts",
    "test:design-lint": "node --test scripts/lint/osmix-design.test.ts",
    "test:packages": "vitest run",
    "test:verify-workspace": "node scripts/verify-workspace.test.ts",
    "verify:all": "node scripts/verify-workspace.ts --all",
    "verify:workspace": "node scripts/verify-workspace.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:deps": "node scripts/check-deps.ts",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version && pnpm install",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "0.2.0",
    "@types/node": "catalog:",
    "oxfmt": "^0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tailwindcss": "1.13.0",
    "oxlint-tsgolint": "^7.0.2001",
    "portless": "0.15.6",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
