{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/merge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node ../../scripts/portless-dev.ts merge.osmix vite",
    "dev:app": "vite",
    "test": "VITEST_INCLUDE_APPS=1 pnpm -w exec vitest run tests --project \"$npm_package_name\"",
