    "clsx": "^2.1.1",
    "comlink": "catalog:",
    "dequal": "catalog:",
    "jotai": "catalog:",
    "jotai-family": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "osmix": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-map-gl": "catalog:",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@osmix/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "catalog:",
