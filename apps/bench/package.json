{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/bench",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "vitest bench",
    "build": "vite build",
    "dev": "node ../../scripts/portless-dev.ts bench.osmix vite",
    "dev:app": "vite",
    "test": "VITEST_INCLUDE_APPS=1 pnpm -w exec vitest run --project '@osmix/bench*'",
    "typecheck": "tsc --build --noEmit"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@osmix/core": "workspace:*",
    "@osmix/geo": "workspace:*",
    "@osmix/geojson": "workspace:*",
    "@osmix/json": "workspace:*",
    "@osmix/pbf": "workspace:*",
    "@osmix/shared": "workspace:*",
    "@osmix/types": "workspace:*",
    "@osmix/vt": "workspace:*",
    "comlink": "catalog:",
    "maplibre-gl": "catalog:",
    "osmix": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-map-gl": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-preview": "^5.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.1"
  }
}
