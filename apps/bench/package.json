{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/bench",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "plan-memory": "node --expose-gc --max-old-space-size=16000 scripts/plan-memory.ts",
    "test": "VITEST_INCLUDE_APPS=1 pnpm -w exec vitest run --project '@osmix/bench*'",
    "typecheck": "tsc --build --noEmit"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@osmix/geo": "workspace:*",
    "@osmix/types": "workspace:*",
    "comlink": "catalog:",
    "maplibre-gl": "catalog:",
    "osmix": "workspace:*",
    "pbf": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-map-gl": "catalog:"
  },
  "devDependencies": {
    "@osmix/shared": "workspace:*",
    "@osmix/test-utils": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-preview": "^5.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.1"
  }
}
