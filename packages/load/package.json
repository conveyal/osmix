{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/load",
  "version": "0.1.1",
  "description": "Load and export OSM data from PBF into Osm indexes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@osmix/core": "workspace:*",
    "@osmix/json": "workspace:*",
    "@osmix/pbf": "workspace:*",
    "@osmix/shared": "workspace:*",
    "@osmix/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
