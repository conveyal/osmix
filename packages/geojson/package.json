{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/geojson",
  "version": "0.0.17",
  "description": "Convert OSM files to and from GeoJSON.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
