{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "osmix",
  "version": "0.4.0",
  "description": "Full OSM toolkit for JavaScript and TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/osmix.worker.ts",
    "./worker-pool": "./src/worker-pool.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/osmix.worker.d.ts",
        "default": "./dist/osmix.worker.js"
      },
      "./worker-pool": {
        "types": "./dist/worker-pool.d.ts",
        "default": "./dist/worker-pool.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fixtures:generate:merge-patch": "node scripts/generate-monaco-merge-patch.ts",
    "profile:merge": "node --expose-gc test/merge-profile-cli.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@osmix/change": "workspace:*",
    "@osmix/core": "workspace:*",
    "@osmix/geo": "workspace:*",
    "@osmix/geojson": "workspace:*",
    "@osmix/geoparquet": "workspace:*",
    "@osmix/gtfs": "workspace:*",
    "@osmix/json": "workspace:*",
    "@osmix/load": "workspace:*",
    "@osmix/pbf": "workspace:*",
    "@osmix/raster": "workspace:*",
    "@osmix/router": "workspace:*",
    "@osmix/shapefile": "workspace:*",
    "@osmix/shared": "workspace:*",
    "@osmix/types": "workspace:*",
    "@osmix/vt": "workspace:*",
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "@mapbox/tilebelt": "^2.0.3",
    "@mapbox/vector-tile": "^3.0.0",
    "@osmix/test-utils": "workspace:*",
    "@types/geojson": "catalog:",
    "pbf": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
