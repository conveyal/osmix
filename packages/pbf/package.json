{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/pbf",
  "version": "0.1.0",
  "description": "A low level, modern, runtime agnostic OSM PBF parser and writer written in TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protobuf": "./src/protobuf.ts",
    "./test/helpers": "./test/helpers.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./protobuf": {
        "types": "./dist/protobuf.d.ts",
        "default": "./dist/protobuf.js"
      },
      "./test/helpers": "./test/helpers.ts"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@osmix/shared": "workspace:*",
    "@osmix/test-utils": "workspace:*",
    "pbf": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
