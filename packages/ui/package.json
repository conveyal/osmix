{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React UI primitives, layout shell and design tokens for Osmix apps",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./state/*": "./src/state/*.ts"
  },
  "scripts": {
    "test": "pnpm -w exec vitest run --project \"$npm_package_name\" --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@osmix/shared": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
