{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/change",
  "version": "0.2.0",
  "description": "An OSM changeset generator and merger built on top of @osmix/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
