{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/change",
  "version": "0.2.0",
  "description": "An OSM changeset generator and merger built on top of @osmix/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "vitest bench",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@osmix/core": "workspace:*",
    "@osmix/geo": "workspace:*",
    "@osmix/router": "workspace:*",
    "@osmix/shared": "workspace:*",
    "@osmix/types": "workspace:*",
    "dequal": "catalog:"
  },
  "devDependencies": {
    "@types/geojson": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
