{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/gtfs",
  "version": "0.0.13",
  "description": "Convert GTFS transit feeds to OSM format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "vitest bench",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@osmix/core": "workspace:*",
    "@osmix/raster": "workspace:*",
    "@osmix/shared": "workspace:*",
    "@osmix/types": "workspace:*",
    "but-unzip": "^0.1.10"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
