{
  "name": "@osmix/shared",
  "version": "0.2.0",
  "description": "Shared utilities for Osmix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/test.json": "./tsconfig/test.json",
    "./tsconfig/app.json": "./tsconfig/app.json",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./tsconfig/base.json": "./tsconfig/base.json",
      "./tsconfig/test.json": "./tsconfig/test.json",
      "./tsconfig/app.json": "./tsconfig/app.json",
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "vitest bench",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
