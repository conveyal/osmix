{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/geo",
  "version": "0.1.1",
  "description": "Geospatial math utilities for Osmix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/tile.ts",
  "exports": {
    ".": "./src/tile.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "main": "./dist/tile.js",
    "types": "./dist/tile.d.ts",
    "exports": {
      ".": {
        "types": "./dist/tile.d.ts",
        "default": "./dist/tile.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@mapbox/tilebelt": "^2.0.3",
    "@osmix/types": "workspace:*",
    "lineclip": "^2.0.0"
  },
  "devDependencies": {
    "@osmix/shared": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
