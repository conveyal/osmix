{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/geo",
  "version": "0.1.1",
  "description": "Geospatial math utilities for Osmix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conveyal/osmix.git"
  },
  "type": "module",
  "main": "./src/tile.ts",
  "exports": {
    ".": "./src/tile.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@osmix/types": "workspace:*",
    "lineclip": "^2.0.0"
  },
  "devDependencies": {
    "@mapbox/tilebelt": "^2.0.3",
    "@osmix/shared": "workspace:*",
    "@types/geojson": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
