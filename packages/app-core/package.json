{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osmix/app-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared worker, storage, state and hooks for the Osmix browser apps",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./workers/*": "./src/workers/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "pnpm -w exec vitest run --project \"$npm_package_name\" --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3",
    "native-file-system-adapter": "^3.0.1",
    "osmix": "workspace:*"
  },
  "devDependencies": {
    "@osmix/shared": "workspace:*",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "comlink": "catalog:",
    "jotai": "catalog:",
    "jotai-family": "catalog:",
    "maplibre-gl": "catalog:",
    "react": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
